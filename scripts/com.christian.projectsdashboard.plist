<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.christian.projectsdashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DASHBOARD_DIR__/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DASHBOARD_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__DASHBOARD_DIR__/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__DASHBOARD_DIR__/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>PORT</key>
        <string>8765</string>
    </dict>
</dict>
</plist>
